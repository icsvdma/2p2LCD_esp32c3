/**
 * ESP32-C3 + 2.2インチLCD ニュースRSSリーダー (表形式一覧版)
 * 
 * 使用LCD: ILI9341 2.2インチ (240x320 縦向き)
 * 使用ボード: Seeed XIAO ESP32C3
 * 使用ライブラリ: LovyanGFX (日本語フォント対応)
 */

#include <Arduino.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>

#include <LovyanGFX.hpp>

// LovyanGFX LCD設定クラス
class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ILI9341 _panel_instance;
  lgfx::Bus_SPI _bus_instance;

public:
  LGFX(void) {
    {
      auto cfg = _bus_instance.config();
      cfg.spi_host = SPI2_HOST;
      cfg.spi_mode = 0;
      cfg.freq_write = 40000000;
      cfg.freq_read  = 16000000;
      cfg.spi_3wire  = false;
      cfg.use_lock   = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;
      cfg.pin_sclk = 8;
      cfg.pin_mosi = 10;
      cfg.pin_miso = 9;
      cfg.pin_dc   = 5;
      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }
    {
      auto cfg = _panel_instance.config();
      cfg.pin_cs   = 7;
      cfg.pin_rst  = 6;
      cfg.pin_busy = -1;
      cfg.memory_width  = 240;
      cfg.memory_height = 320;
      cfg.panel_width   = 240;
      cfg.panel_height  = 320;
      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;
      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits  = 1;
      cfg.readable = true;
      cfg.invert   = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;
      _panel_instance.config(cfg);
    }
    setPanel(&_panel_instance);
  }
};

// WiFi設定
const char* ssid = "TP-Link_B710";
const char* password = "VldH8SNX!vs!";

// Yahoo!ニュース RSS URL (全トピックス)
const char* rssUrls[] = {
  "https://news.yahoo.co.jp/rss/topics/top-picks.xml",     // 主要
  "https://news.yahoo.co.jp/rss/topics/domestic.xml",      // 国内
  "https://news.yahoo.co.jp/rss/topics/world.xml",         // 国際
  "https://news.yahoo.co.jp/rss/topics/business.xml",      // 経済
  "https://news.yahoo.co.jp/rss/topics/entertainment.xml", // エンタメ
  "https://news.yahoo.co.jp/rss/topics/sports.xml",        // スポーツ
  "https://news.yahoo.co.jp/rss/topics/it.xml",            // IT
  "https://news.yahoo.co.jp/rss/topics/science.xml",       // 科学
  "https://news.yahoo.co.jp/rss/topics/local.xml"          // 地域
};
const char* topicNames[] = {"主要", "国内", "国際", "経済", "エンタメ", "スポーツ", "IT", "科学", "地域"};
const int RSS_COUNT = 9;

// 最大記事数
#define MAX_ARTICLES 200

// 記事データ構造 (タイトルのみ保持してメモリ節約)
struct Article {
  String title;
};

Article articles[MAX_ARTICLES];
int articleCount = 0;
int currentPage = 0;

// 表示設定
#define HEADER_HEIGHT 18
#define FOOTER_HEIGHT 16
#define LINE_HEIGHT 15
#define CONTENT_HEIGHT (320 - HEADER_HEIGHT - FOOTER_HEIGHT)
#define ITEMS_PER_PAGE (CONTENT_HEIGHT / LINE_HEIGHT)

// 更新間隔 (10分)
const unsigned long UPDATE_INTERVAL = 600000;
unsigned long lastUpdate = 0;

// ページ自動切り替え間隔 (5秒)
const unsigned long PAGE_INTERVAL = 5000;
unsigned long lastPageChange = 0;

// LCDオブジェクト
LGFX tft;

// WiFi接続
void connectWiFi() {
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setFont(&fonts::efontJA_12);
  tft.setCursor(10, 10);
  tft.println("WiFi接続中...");
  tft.print("SSID: ");
  tft.println(ssid);
  
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    tft.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    tft.println();
    tft.println("接続成功!");
  } else {
    tft.println();
    tft.println("接続失敗");
  }
  delay(1000);
}

// XMLタグから値を抽出
String extractXmlValue(const String& xml, const String& tag) {
  String startTag = "<" + tag;
  String endTag = "</" + tag + ">";
  
  int startPos = xml.indexOf(startTag);
  if (startPos < 0) return "";
  
  int tagEnd = xml.indexOf(">", startPos);
  if (tagEnd < 0) return "";
  
  int valueStart = tagEnd + 1;
  int endPos = xml.indexOf(endTag, valueStart);
  
  if (endPos < 0) return "";
  
  String value = xml.substring(valueStart, endPos);
  value.replace("<![CDATA[", "");
  value.replace("]]>", "");
  value.trim();
  
  return value;
}

// タイトルの重複チェック
bool isDuplicate(const String& title) {
  for (int i = 0; i < articleCount; i++) {
    if (articles[i].title == title) return true;
  }
  return false;
}

// 単一のRSSフィードをパース
int parseRSS(const String& payload) {
  int added = 0;
  int searchStart = 0;
  
  while (articleCount < MAX_ARTICLES) {
    int itemStart = payload.indexOf("<item>", searchStart);
    if (itemStart < 0) break;
    
    int itemEnd = payload.indexOf("</item>", itemStart);
    if (itemEnd < 0) break;
    
    String item = payload.substring(itemStart, itemEnd + 7);
    String title = extractXmlValue(item, "title");
    
    // HTMLエンティティをデコード
    title.replace("&amp;", "&");
    title.replace("&lt;", "<");
    title.replace("&gt;", ">");
    title.replace("&quot;", "\"");
    title.replace("&#39;", "'");
    
    if (title.length() > 0 && !isDuplicate(title)) {
      articles[articleCount].title = title;
      articleCount++;
      added++;
    }
    
    searchStart = itemEnd + 7;
  }
  return added;
}

// 全トピックスからRSSフィード取得＆パース
bool fetchRSS() {
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setFont(&fonts::efontJA_12);
  tft.setCursor(10, 100);
  tft.println("全トピックス取得中...");
  
  articleCount = 0;
  WiFiClientSecure client;
  client.setInsecure();
  
  for (int i = 0; i < RSS_COUNT && articleCount < MAX_ARTICLES; i++) {
    tft.setCursor(10, 130 + i * 14);
    tft.printf("%s...", topicNames[i]);
    
    HTTPClient http;
    http.begin(client, rssUrls[i]);
    http.setTimeout(10000);
    
    int httpCode = http.GET();
    
    if (httpCode == HTTP_CODE_OK) {
      String payload = http.getString();
      int added = parseRSS(payload);
      tft.printf(" +%d", added);
      Serial.printf("%s: +%d (total: %d)\n", topicNames[i], added, articleCount);
    } else {
      tft.print(" Err");
      Serial.printf("%s: HTTP error %d\n", topicNames[i], httpCode);
    }
    http.end();
    delay(100); // サーバー負荷軽減
  }
  
  Serial.printf("Total articles: %d\n", articleCount);
  return articleCount > 0;
}

// 総ページ数を計算
int getTotalPages() {
  return (articleCount + ITEMS_PER_PAGE - 1) / ITEMS_PER_PAGE;
}

// 1行のテキストを描画（長い場合は切り詰め）
void drawTruncatedText(int x, int y, int maxWidth, const String& text, uint16_t color) {
  tft.setTextColor(color, TFT_BLACK);
  
  String displayText = text;
  int textWidth = tft.textWidth(displayText);
  
  // テキストが長すぎる場合は切り詰め
  while (textWidth > maxWidth && displayText.length() > 3) {
    int len = displayText.length();
    int removeBytes = 1;
    uint8_t lastChar = displayText.charAt(len - 1);
    
    // UTF-8マルチバイト文字の処理
    if ((lastChar & 0x80) != 0) {
      while (removeBytes < len && removeBytes < 4) {
        uint8_t c = displayText.charAt(len - removeBytes - 1);
        if ((c & 0xC0) == 0xC0) {
          removeBytes++;
          break;
        }
        removeBytes++;
      }
    }
    
    displayText = displayText.substring(0, len - removeBytes);
    textWidth = tft.textWidth(displayText + "..");
  }
  
  if (displayText.length() < text.length()) {
    displayText += "..";
  }
  
  tft.setCursor(x, y);
  tft.print(displayText);
}

// ニュース一覧を表示
void displayNewsList() {
  tft.fillScreen(TFT_BLACK);
  
  // ヘッダー
  tft.fillRect(0, 0, 240, HEADER_HEIGHT, TFT_DARKGREEN);
  tft.setTextColor(TFT_WHITE, TFT_DARKGREEN);
  tft.setFont(&fonts::Font0);
  tft.setCursor(5, 4);
  tft.print("Yahoo News ");
  
  int totalPages = getTotalPages();
  tft.print(currentPage + 1);
  tft.print("/");
  tft.print(totalPages);
  tft.print(" (");
  tft.print(articleCount);
  tft.print("件)");
  
  // 記事一覧
  tft.setFont(&fonts::efontJA_12);
  
  int startIdx = currentPage * ITEMS_PER_PAGE;
  int endIdx = min(startIdx + ITEMS_PER_PAGE, articleCount);
  
  for (int i = startIdx; i < endIdx; i++) {
    int y = HEADER_HEIGHT + (i - startIdx) * LINE_HEIGHT + 1;
    int itemNum = i + 1;
    
    // 交互に背景色を変える
    if ((i - startIdx) % 2 == 1) {
      tft.fillRect(0, y, 240, LINE_HEIGHT, tft.color565(20, 20, 30));
    }
    
    // 番号
    tft.setTextColor(TFT_CYAN, (i - startIdx) % 2 == 1 ? tft.color565(20, 20, 30) : TFT_BLACK);
    tft.setCursor(2, y + 1);
    if (itemNum < 10) tft.print(" ");
    tft.print(itemNum);
    
    // タイトル
    uint16_t bgColor = (i - startIdx) % 2 == 1 ? tft.color565(20, 20, 30) : TFT_BLACK;
    tft.setTextColor(TFT_WHITE, bgColor);
    
    String displayText = articles[i].title;
    int textWidth = tft.textWidth(displayText);
    int maxWidth = 215;
    
    while (textWidth > maxWidth && displayText.length() > 3) {
      int len = displayText.length();
      int removeBytes = 1;
      uint8_t lastChar = displayText.charAt(len - 1);
      if ((lastChar & 0x80) != 0) {
        while (removeBytes < len && removeBytes < 4) {
          uint8_t c = displayText.charAt(len - removeBytes - 1);
          if ((c & 0xC0) == 0xC0) { removeBytes++; break; }
          removeBytes++;
        }
      }
      displayText = displayText.substring(0, len - removeBytes);
      textWidth = tft.textWidth(displayText + "..");
    }
    if (displayText.length() < articles[i].title.length()) {
      displayText += "..";
    }
    
    tft.setCursor(24, y + 1);
    tft.print(displayText);
  }
  
  // フッター
  tft.fillRect(0, 320 - FOOTER_HEIGHT, 240, FOOTER_HEIGHT, TFT_NAVY);
  tft.setTextColor(TFT_LIGHTGREY, TFT_NAVY);
  tft.setFont(&fonts::Font0);
  tft.setCursor(5, 320 - FOOTER_HEIGHT + 4);
  tft.print("Auto:");
  tft.print(PAGE_INTERVAL / 1000);
  tft.print("s | Update:");
  tft.print(UPDATE_INTERVAL / 60000);
  tft.print("min");
}

// 次のページ
void nextPage() {
  int totalPages = getTotalPages();
  if (totalPages > 0) {
    currentPage = (currentPage + 1) % totalPages;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n\n=== News RSS Reader (List View) ===");
  
  tft.init();
  tft.setRotation(0);
  tft.fillScreen(TFT_BLACK);
  
  // スプラッシュ画面
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setFont(&fonts::efontJA_16);
  tft.setTextSize(2);
  tft.drawString("NEWS", 120, 100);
  tft.setTextSize(1);
  tft.drawString("一覧表示版", 120, 160);
  tft.setFont(&fonts::Font0);
  tft.setTextColor(TFT_DARKGREY, TFT_BLACK);
  tft.drawString("ESP32-C3 + LovyanGFX", 120, 200);
  tft.setTextDatum(TL_DATUM);
  delay(1500);
  
  connectWiFi();
  
  if (WiFi.status() != WL_CONNECTED) {
    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextDatum(MC_DATUM);
    tft.setFont(&fonts::efontJA_16);
    tft.drawString("WiFiエラー!", 120, 160);
    tft.setTextDatum(TL_DATUM);
    while(1) delay(1000);
  }
  
  if (fetchRSS()) {
    displayNewsList();
  } else {
    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextDatum(MC_DATUM);
    tft.setFont(&fonts::efontJA_16);
    tft.drawString("RSS取得失敗!", 120, 160);
    tft.setTextDatum(TL_DATUM);
  }
  
  lastUpdate = millis();
  lastPageChange = millis();
}

void loop() {
  // 5秒ごとにページを自動切り替え
  if (articleCount > 0 && millis() - lastPageChange >= PAGE_INTERVAL) {
    nextPage();
    displayNewsList();
    lastPageChange = millis();
  }
  
  // 定期更新 (10分毎)
  if (millis() - lastUpdate >= UPDATE_INTERVAL) {
    if (fetchRSS()) {
      currentPage = 0;
      displayNewsList();
    }
    lastUpdate = millis();
    lastPageChange = millis();
  }
  
  delay(100);
}
