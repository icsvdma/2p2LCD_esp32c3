/**
 * 接続情報のテンプレート
 *
 * このファイルを src/secrets.h にコピーして値を書き換えること。
 * src/secrets.h は .gitignore 済みなのでコミットされない。
 */
#pragma once

// WiFi 接続情報 (RSSリーダーでは AP モードで上書き可能)
#define SSID     "your-ssid"
#define PASSWORD "your-password"

/*
 * (任意) HTTPS 接続先サーバーのルート CA 証明書 (PEM)。
 * 定義するとサーバー証明書を検証する。未定義の場合は検証を行わない
 * (中間者攻撃に対して無防備になるので、可能なら設定を推奨)。
 * 接続先が複数ある場合は、必要な CA をすべて連結した PEM を指定する
 * (含まれない CA のサーバーには接続できなくなる)。
 *
 * #define ROOT_CA_PEM \
 *   "-----BEGIN CERTIFICATE-----\n" \
 *   "...\n" \
 *   "-----END CERTIFICATE-----\n"
 */
